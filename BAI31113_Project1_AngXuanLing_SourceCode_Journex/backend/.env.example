# ==============================================================================
# Agentic AI Accounting System - Environment Configuration Template
# ==============================================================================

# LLM Provider Configuration
ACTIVE_PROVIDER=GROQ
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# OpenRouter removed - Groq LPU is the dedicated engine



# Gmail Email Ingestion Configuration
# Receiving inbox address for the company's accounting documents
GMAIL_COMPANY_INBOX=shriley.ling@gmail.com

# Paths to OAuth 2.0 client secrets and user token file (relative to backend/ or absolute)
GMAIL_CREDENTIALS_FILE=credentials/credentials.json
GMAIL_TOKEN_FILE=credentials/token.json

# Polling interval in seconds for automatic Gmail document collection (default: 300 = 5 minutes)
GMAIL_POLL_INTERVAL_SECONDS=300

# Optional query filter for Gmail API (e.g. has:attachment)
GMAIL_SEARCH_QUERY=has:attachment

# Local Folder Document Collection Configuration
# Windows directory path monitored for incoming invoice/receipt documents
LOCAL_FOLDER_PATH=D:\CompanyInvoice
LOCAL_FOLDER_POLL_INTERVAL_SECONDS=5

# ABC Bank Simulator Ingestion Configuration
ABC_BANK_API_BASE_URL=http://localhost:8010
ABC_BANK_POLL_INTERVAL_SECONDS=30
ABC_BANK_TIMEOUT_SECONDS=10.0
